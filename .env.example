# ────────────────────────────────────────────────────────────────
#  IB-MIRESAN — variables d'environnement
#  Copier vers .env.local (jamais commité).
# ────────────────────────────────────────────────────────────────

# Mode de données :
#   demo      → données de démonstration en mémoire (aucun appel Firebase)
#   firebase  → Firebase Auth + Firestore + Storage réels
NEXT_PUBLIC_DATA_MODE=demo

# Utiliser les émulateurs locaux (firebase emulators:start)
NEXT_PUBLIC_USE_EMULATORS=false

# URL publique canonique du site (SEO, QR codes de vérification)
NEXT_PUBLIC_SITE_URL=https://miresan-bible-institute.web.app

# Configuration Web Firebase (publique par nature — ce ne sont pas des secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBfzzOiNoeih01dGkk9BCqXwjH9vndEbkI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=miresan-bible-institute.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=miresan-bible-institute
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=miresan-bible-institute.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=478813803912
NEXT_PUBLIC_FIREBASE_APP_ID=1:478813803912:web:196ce8fea3e06e1c87963d

# App Check (reCAPTCHA Enterprise site key) — laisser vide pour désactiver
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# Domaine technique des identités internes (login par identifiant, ex. « pasteurarmel »)
NEXT_PUBLIC_IDENTITY_DOMAIN=id.miresan-bible-institute.app

# ── Scripts serveur uniquement (Admin SDK) — NE JAMAIS préfixer par NEXT_PUBLIC ──
# Chemin vers la clé de compte de service (ou utiliser `gcloud auth application-default login`)
GOOGLE_APPLICATION_CREDENTIALS=
# Compte d'administration initial (scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
